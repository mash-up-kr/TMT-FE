{
  "name": "ttalkkak-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck && pnpm build",
    "env:sync": "node _scripts/env-sync.mjs",
    "api-gen": "node --env-file-if-exists=.env _scripts/api/fetch-openapi.mjs && orval"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.100.8",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "orval": "^8.23.0",
    "typescript": "^5"
  }
}
