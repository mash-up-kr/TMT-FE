# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
/.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 에이전트 작업 명세
/docs/superpowers/specs/

# AI 도구 로컬 산출물 (biome이 vcs.useIgnoreFile로 이 파일을 따르므로, 빠지면 pnpm check가 오염됨)
/.omc/
/.omx/
/.context/

# .claude 내부 개인 작업 파일
/.claude/private/
